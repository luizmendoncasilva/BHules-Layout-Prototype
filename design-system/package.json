{
  "name": "@bhubai/bhub-design-system",
  "version": "1.4.1",
  "description": "BHub Design System - UI component library built on shadcn/ui, Radix UI, and Tailwind CSS",
  "author": {
    "name": "tech-team@bhub.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/BHubAI/bhub-design-system.git"
  },
  "homepage": "https://github.com/BHubAI/bhub-design-system",
  "bugs": {
    "url": "https://github.com/BHubAI/bhub-design-system/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "typesVersions": {
    "*": {
      "icons": [
        "./dist/icons.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons": {
      "import": "./dist/esm/icons.js",
      "require": "./dist/cjs/icons.js",
      "types": "./dist/icons.d.ts"
    },
    "./dist/styles.css": "./dist/styles.css"
  },
  "type": "module",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build:next": "next build",
    "start": "next start",
    "build": "rimraf dist && NODE_ENV=production rollup -c && cp dist/esm/styles.css dist/styles.css",
    "lint": "eslint",
    "ci": "npm run lint && npm run test -- --watch=false",
    "test": "playwright install chromium && vitest --config ./vitest.config.ts",
    "test:coverage": "playwright install chromium && vitest --config ./vitest.config.ts --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "semantic-release"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.13.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@rollup/plugin-alias": "^5",
    "@rollup/plugin-commonjs": "^28",
    "@rollup/plugin-node-resolve": "^16",
    "@rollup/plugin-terser": "^1.0",
    "@rollup/plugin-typescript": "^12",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@storybook/addon-a11y": "^10.2.11",
    "@storybook/addon-docs": "^10.2.11",
    "@storybook/addon-vitest": "^10.2.11",
    "@storybook/nextjs-vite": "^10.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "chromatic": "^15.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-storybook": "^10.2.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "next": "16.2.6",
    "playwright": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "^6",
    "rollup": "^4",
    "rollup-plugin-dts": "^6",
    "rollup-plugin-peer-deps-external": "^2",
    "rollup-plugin-postcss": "^4",
    "semantic-release": "^25.0.3",
    "shadcn": "^3.8.5",
    "storybook": "^10.2.11",
    "tailwindcss": "^4",
    "tslib": "^2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.2",
    "vitest": "^4.1.0",
    "vitest-browser-react": "^2.0.5"
  }
}
